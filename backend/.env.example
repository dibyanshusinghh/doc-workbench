# HTTP port for the API server
PORT=4000

# SQLite database file (created automatically)
DATABASE_PATH=./data/workbench.db

# Upload limits
MAX_FILE_SIZE_MB=5
MAX_FILES=10

# Large-document handling
MAX_CHARS_PER_DOC=100000
CHUNK_SIZE=4000

# AI provider (only "mock" is implemented)
LLM_PROVIDER=mock
